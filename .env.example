# ====================================================
# DATABASE (Neon Postgres - Required for Vercel)
# ====================================================
# Get your free Neon database at: https://neon.tech
# After creating a database, copy the connection strings from:
# Neon Dashboard -> Your Project -> Connection Details

# Pooled connection (used by Next.js / Prisma for queries)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# Direct connection (used by Prisma migrations / db push)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

