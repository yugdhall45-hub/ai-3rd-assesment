generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  password         String
  name             String
  role             String            @default("OWNER")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  businessProfile  BusinessProfile?
  products         Product[]
  customers        Customer[]
  suppliers        Supplier[]
  invoices         Invoice[]
  purchases        Purchase[]
  payments         Payment[]
  supplierPayments SupplierPayment[]
  expenses         Expense[]
  otherIncomes     OtherIncome[]
  daybookRegisters DaybookRegister[]
  stockMovements   StockMovement[]
  bankAccounts     BankAccount[]
  transactions     Transaction[]
  auditLogs        AuditLog[]
  staffMembers     StaffMember[]
}

model BusinessProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String   @default("My Local Store")
  tagline       String   @default("Quality Products & Daily Essentials")
  phone         String   @default("+91 98765 43210")
  email         String   @default("store@business.local")
  address       String   @default("Shop No. 12, Main Market, City")
  taxId         String   @default("GSTIN: 27AABCU9603R1ZM")
  currency      String   @default("₹")
  receiptFooter String   @default("Thank you for your visit! Please come again.")
  taxRate       Float    @default(0.0)
  updatedAt     DateTime @updatedAt
}

model Product {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  sku            String?
  category       String          @default("General")
  brand          String?
  costPrice      Float           @default(0)
  sellingPrice   Float
  stock          Int             @default(0)
  minStockLevel  Int             @default(5)
  unit           String          @default("pcs")
  description    String?
  items          InvoiceItem[]
  purchaseItems  PurchaseItem[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId])
  @@index([userId, category])
}

model Customer {
  id             String     @id @default(uuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerCode   String?
  name           String
  phone          String?
  email          String?
  address        String?
  openingBalance Float      @default(0)
  notes          String?
  invoices       Invoice[]
  payments       Payment[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([userId])
  @@index([userId, phone])
}

model Supplier {
  id                 String            @id @default(uuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditorCode       String?
  name               String
  businessName       String?
  phone              String?
  email              String?
  address            String?
  openingBalance     Float             @default(0)
  currentBalance     Float             @default(0)
  paymentTerms       String?
  notes              String?
  purchases          Purchase[]
  supplierPayments   SupplierPayment[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([userId])
  @@index([userId, phone])
}

model Invoice {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceNumber String
  date          DateTime      @default(now())
  dateString    String
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String        @default("Walk-in Customer")
  customerPhone String?
  subtotal      Float
  discount      Float         @default(0)
  tax           Float         @default(0)
  total         Float
  paidAmount    Float         @default(0)
  dueAmount     Float         @default(0)
  paymentStatus String        @default("PAID")
  paymentMethod String        @default("CASH")
  notes         String?
  items         InvoiceItem[]
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([userId, invoiceNumber])
  @@index([userId])
  @@index([userId, dateString])
  @@index([userId, date])
  @@index([userId, customerId])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  quantity    Int      @default(1)
  unitPrice   Float
  total       Float
}

model Purchase {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchaseNumber String
  date           DateTime        @default(now())
  dateString     String
  supplierId     String?
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName   String          @default("Direct Supplier")
  subtotal       Float
  discount       Float           @default(0)
  tax            Float           @default(0)
  total          Float
  paidAmount     Float           @default(0)
  dueAmount      Float           @default(0)
  paymentStatus  String          @default("PAID")
  paymentMethod  String          @default("CASH")
  notes          String?
  items          PurchaseItem[]
  payments       SupplierPayment[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([userId, purchaseNumber])
  @@index([userId])
  @@index([userId, dateString])
  @@index([userId, supplierId])
}

model PurchaseItem {
  id           String    @id @default(uuid())
  purchaseId   String
  purchase     Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String
  quantity     Int       @default(1)
  unitCost     Float
  total        Float
}

model Payment {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceId     String?
  invoice       Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  amount        Float
  paymentMethod String    @default("CASH")
  paymentDate   DateTime  @default(now())
  dateString    String
  notes         String?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([userId, dateString])
  @@index([userId, customerId])
}

model SupplierPayment {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplierId    String
  supplier      Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchaseId    String?
  purchase      Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  amount        Float
  paymentMethod String    @default("CASH")
  paymentDate   DateTime  @default(now())
  dateString    String
  reference     String?
  notes         String?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([supplierId])
  @@index([userId, dateString])
}

model StockMovement {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          String   // PURCHASE, SALE, RETURN, DAMAGE, ADJUSTMENT
  quantity      Int      // Change amount (+ or -)
  previousStock Int
  newStock      Int
  reason        String?
  referenceId   String?  // Invoice # or Purchase #
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([productId])
  @@index([userId, type])
}

model BankAccount {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName      String
  accountHolder String
  accountNumber String
  ifscCode      String?
  upiId         String?
  balance       Float    @default(0)
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model Transaction {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  txnNumber     String   // TXN-000001
  type          String   // MONEY_IN, MONEY_OUT, TRANSFER
  category      String   // SALE, PURCHASE, EXPENSE, CUSTOMER_PAYMENT, SUPPLIER_PAYMENT, BANK_TRANSFER, OTHER
  amount        Float
  paymentMode   String   // CASH, UPI, BANK_TRANSFER, CHEQUE, CARD
  partyName     String?
  reference     String?
  description   String?
  date          DateTime @default(now())
  dateString    String
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([userId, dateString])
  @@index([userId, category])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String   // CREATE, UPDATE, DELETE, VOID, SETTLE
  entityType  String   // INVOICE, PURCHASE, PRODUCT, CUSTOMER, SUPPLIER, EXPENSE, DAYBOOK, BANK
  entityId    String
  details     String
  performedBy String   @default("Owner")
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([userId, entityType])
}

model StaffMember {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  role        String   @default("STAFF") // OWNER, MANAGER, ACCOUNTANT, STAFF
  pin         String?
  salary      Float?
  isActive    Boolean  @default(true)
  permissions String?  // JSON string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Expense {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  category      String
  amount        Float
  paymentMethod String   @default("CASH")
  date          DateTime @default(now())
  dateString    String
  reference     String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([userId, dateString])
  @@index([userId, date])
}

model OtherIncome {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  source        String
  amount        Float
  paymentMethod String   @default("CASH")
  date          DateTime @default(now())
  dateString    String
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([userId, dateString])
  @@index([userId, date])
}

model DaybookRegister {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateString   String
  openingCash  Float    @default(0)
  cashInflow   Float    @default(0)
  cashOutflow  Float    @default(0)
  expectedCash Float    @default(0)
  actualCash   Float?
  difference   Float?
  notes        String?
  isClosed     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, dateString])
  @@index([userId])
}
