generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BusinessProfile {
  id             String   @id @default("default")
  name           String   @default("My Local Store")
  tagline        String   @default("Quality Products & Daily Essentials")
  phone          String   @default("+91 98765 43210")
  email          String   @default("store@business.local")
  address        String   @default("Shop No. 12, Main Market, City")
  taxId          String   @default("GSTIN: 27AABCU9603R1ZM")
  currency       String   @default("₹")
  receiptFooter  String   @default("Thank you for your visit! Please come again.")
  taxRate        Float    @default(0.0)
  updatedAt      DateTime @updatedAt
}

model Product {
  id           String        @id @default(uuid())
  name         String
  sku          String?       @unique
  category     String        @default("General")
  costPrice    Float         @default(0)
  sellingPrice Float
  stock        Int           @default(0)
  unit         String        @default("pcs")
  items        InvoiceItem[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Customer {
  id        String     @id @default(uuid())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  invoices  Invoice[]
  payments  Payment[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  date          DateTime      @default(now())
  dateString    String
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String        @default("Walk-in Customer")
  customerPhone String?
  subtotal      Float
  discount      Float         @default(0)
  tax           Float         @default(0)
  total         Float
  paidAmount    Float         @default(0)
  dueAmount     Float         @default(0)
  paymentStatus String        @default("PAID")
  paymentMethod String        @default("CASH")
  notes         String?
  items         InvoiceItem[]
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  quantity    Int      @default(1)
  unitPrice   Float
  total       Float
}

model Payment {
  id            String    @id @default(uuid())
  invoiceId     String?
  invoice       Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  amount        Float
  paymentMethod String    @default("CASH")
  paymentDate   DateTime  @default(now())
  dateString    String
  notes         String?
  createdAt     DateTime  @default(now())
}

model Expense {
  id            String   @id @default(uuid())
  title         String
  category      String
  amount        Float
  paymentMethod String   @default("CASH")
  date          DateTime @default(now())
  dateString    String
  reference     String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model OtherIncome {
  id            String   @id @default(uuid())
  title         String
  source        String
  amount        Float
  paymentMethod String   @default("CASH")
  date          DateTime @default(now())
  dateString    String
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DaybookRegister {
  id           String   @id @default(uuid())
  dateString   String   @unique
  openingCash  Float    @default(0)
  cashInflow   Float    @default(0)
  cashOutflow  Float    @default(0)
  expectedCash Float    @default(0)
  actualCash   Float?
  difference   Float?
  notes        String?
  isClosed     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
